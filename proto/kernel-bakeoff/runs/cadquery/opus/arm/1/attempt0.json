 "api_error_status": null,
 "result": "```python\nimport cadquery as cq\n\nT = 6.0\nW = 40.0\nR = W / 2\nC2C = 250.0\nL = C2C + 2 * R  # 290\nBORE_D = 28.0\nPOCKET_L = 30.0\nPOCKET_W = 20.0\nPOCKET_R = 3.0\nPOCKET_X = [62.5, 125.0, 187.5]\n\n# Base plate with fully rounded ends (bore centers at x=0 and x=250)\nplate = (\n    cq.Workplane(\"XY\")\n    .center(C2C / 2, 0)\n    .slot2D(L, W, 0)\n    .extrude(T)\n)\n\n# Bearing bores\nplate = (\n    plate.faces(\">Z\").workplane(origin=(0, 0, T))\n    .pushPoints([(0, 0), (C2C, 0)])\n    .hole(BORE_D)\n)\n\n# Lightening pockets (through) with rounded corners\nfor x in POCKET_X:\n    pocket = (\n        cq.Workplane(\"XY\")\n        .center(x, 0)\n        .rect(POCKET_L, POCKET_W)\n        .extrude(T)\n        .edges(\"|Z\")\n        .fillet(POCKET_R)\n    )\n    plate = plate.cut(pocket)\n\nresult = plate.val()\ncq.exporters.export(cq.Workplane().add(result), \"out.step\")\n```",
